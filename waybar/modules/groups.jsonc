{
    "group/applications": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 650,
            "transition-right-to-left:": false
        },
        "modules": [
            "custom/terminal",
            "custom/code",
            "custom/browser",
            "custom/spotify",
            "custom/files",
            "custom/obsidian"
        ]
    },
    "group/hardware": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 650,
            "transition-right-to-left:": false
        },
        "modules": [
            "cpu",
            "memory",
            "load",
            "disk",
            "temperature"
        ]
    },
    "group/system": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 650,
            "transition-right-to-left:": false
        },
        "modules": [
            "battery",
            "backlight",
            "pulseaudio"
        ]
    },
    "group/media": {
        "orientation": "horizontal",
        "modules": [
            "custom/media_play",
            "custom/media_time",
            "custom/cava"
        ]
    }
}