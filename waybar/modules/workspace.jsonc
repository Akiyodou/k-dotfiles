{
    "hyprland/workspaces": {
        "format": "{name}: {icon}",
        "on-click": "activate",
        "format-icons": {
            "1": "Web",
            "2": "Code",
            "3": "Music",
            "4": "Chat",
            "5": "Misc",
            "active": "●",
            "default": "○"
        },
        "persistent-workspaces": {
            "*": 5 // 5 Workspaces by default
        }
    }
}