{
    "custom/media_play": {
        "exec": "~/.config/waybar/scripts/media_play.sh",
        "on-click": "playerctl play-pause",
        "escape": true,
        "tooltip": true
    },
    "custom/media_animation": {
        "exec": "~/.config/waybar/scripts/media_animation.sh",
        "tooltip": false
    },
    "custom/media_time": {
        "exec": "~/.config/waybar/scripts/media_time.sh",
        "escape": true,
        "tooltip": false,
        "interval": 1
    },
    "custom/cava": {
        "exec": "~/.config/waybar/scripts/cava.sh",
        "return-type": "string",
        "escape": true,
        "format": "{}",
        "tooltip": false
    }
}