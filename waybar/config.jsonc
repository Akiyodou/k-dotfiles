 *@author Akiyodou
 *@repo github_link
*/
{
    "layer": "top",
    "height": 20,
    "spacing": 6,
    "include": [
        "./modules/groups.jsonc",
        "./modules/hardware.jsonc",
        "./modules/workspace.jsonc",
        "./modules/system.jsonc",
        "./modules/clock.jsonc",
        "./modules/mpris.jsonc"
    ],
    "modules-left": [
        "hyprland/workspaces",
        "mpris",
        "hyprland/submap"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "custom/notification",
        "group/hardware",
        "group/system",
        "clock"
    ],
    "hyprland/window": {
        "format": "{initialTitle}",
        "max-length": 30,
        "icon" : true,
        "icon-size": 24,
        "fallback": "AkiArch"
    }
}