/*
 *@author Akiyodou
 *@repo github_link
*/
{
    "layer": "top",
    "height": 20,
    "spacing": 6,
    "include": [
        "./modules/groups.jsonc",
        "./modules/hardware.jsonc",
        "./modules/workspace.jsonc",
        "./modules/system.jsonc",
        "./modules/clock.jsonc",
        "./modules/bluetooth.jsonc",
        "./modules/mpris.jsonc",
        "./modules/idle_inhibitor.jsonc",
        "./modules/apps.jsonc",
        "./modules/media.jsonc"
    ],
    "modules-left": [
        "group/applications",
        "group/media",
        "idle_inhibitor",
        "hyprland/submap"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "bluetooth",
        "custom/notification",
        "group/hardware",
        "group/system",
        "clock"
    ],
    "hyprland/window": {
        "format": "{initialTitle}",
        "max-length": 30,
        "icon" : true,
        "icon-size": 24,
        "fallback": "AkiArch"
    }
}
